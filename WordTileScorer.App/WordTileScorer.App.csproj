<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WordTileScorer.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Word Tile Scorer</ApplicationTitle>
    <ApplicationId>ie.wordtilescorer.dev</ApplicationId>
    <ApplicationDisplayVersion>0.3.5</ApplicationDisplayVersion>
    <ApplicationVersion>14</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WordTileScorer.Core/WordTileScorer.Core.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#0B6E4F" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0B6E4F" BaseSize="128,128" />
  </ItemGroup>
</Project>
